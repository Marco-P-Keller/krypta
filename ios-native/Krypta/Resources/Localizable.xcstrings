    "%@ hat die Löschfrist auf %@ gesetzt.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ set messages to disappear after %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ configuró que los mensajes desaparezcan tras %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a réglé la suppression des messages sur %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha impostato l’eliminazione dei messaggi dopo %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft ingesteld dat berichten na %2$@ verdwijnen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ definiu que as mensagens desapareçam após %2$@."
          }
        }
      }
    },
    "%@ hat die Löschfrist ausgeschaltet.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ turned off disappearing messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ desactivó los mensajes temporales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a désactivé les messages éphémères."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha disattivato i messaggi a tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft verdwijnende berichten uitgezet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ desativou as mensagens temporárias."
          }
        }
      }
    },
