        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo es demasiado grande. El máximo es 25 MB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est trop volumineux. 25 Mo au maximum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è troppo grande. Al massimo 25 MB."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand is te groot. Maximaal 25 MB."
          }
        },
        "pt": {
