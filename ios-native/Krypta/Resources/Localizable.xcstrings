        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore vérifié"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora verificato"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet gecontroleerd"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não verificado"
          }
        }
      }
    },
    "Noch nicht geprüft. Krypta holt die Kette beim nächsten Start oder sobald der Server erreichbar ist.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not checked yet. Krypta fetches the chain on the next launch or as soon as the server can be reached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no comprobado. Krypta obtendrá la cadena en el próximo inicio o en cuanto el servidor esté disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore vérifié. Krypta récupère la chaîne au prochain lancement ou dès que le serveur est joignable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora verificato. Krypta scarica la catena al prossimo avvio o appena il server è raggiungibile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet gecontroleerd. Krypta haalt de keten op bij de volgende start of zodra de server bereikbaar is."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não verificado. O Krypta busca a cadeia na próxima abertura ou assim que o servidor estiver disponível."
          }
        }
      }
    },
    "Noch nicht gesichert. Ohne die Wörter ist dein Bitcoin weg, wenn Krypta alles löscht oder das iPhone verloren geht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not backed up yet. Without the words your bitcoin is gone if Krypta erases everything or the iPhone is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún sin guardar. Sin las palabras tu bitcoin se pierde si Krypta lo borra todo o pierdes el iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore sauvegardés. Sans les mots, tes bitcoins sont perdus si Krypta efface tout ou si l'iPhone est perdu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora salvate. Senza le parole i tuoi bitcoin sono persi se Krypta cancella tutto o perdi l'iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet opgeslagen. Zonder de woorden is je bitcoin weg als Krypta alles wist of de iPhone kwijtraakt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não guardadas. Sem as palavras, seu bitcoin se perde se o Krypta apagar tudo ou o iPhone se perder."
          }
        }
      }
    },
    "Noch niemand, den du einladen kannst. Mitglieder brauchen die aktuelle Krypta-App und müssen deine Anfrage angenommen haben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one you can invite yet. Members need the current Krypta app and must have accepted your request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nadie a quien puedas invitar. Los miembros necesitan la app actual de Krypta y deben haber aceptado tu solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne à inviter pour l’instant. Les membres ont besoin de l’app Krypta actuelle et doivent avoir accepté ta demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuno da invitare. I membri devono avere l’app Krypta aggiornata e aver accettato la tua richiesta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niemand die je kunt uitnodigen. Leden hebben de actuele Krypta-app nodig en moeten je verzoek hebben geaccepteerd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há ninguém para convidar. Os membros precisam do app Krypta atual e devem ter aceitado sua solicitação."
          }
        }
      }
    },
