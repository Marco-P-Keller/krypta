    "Löscht Schlüssel, Chats und dein Konto auf dem Server. Deine Kontakte erfahren, dass es dich nicht mehr gibt.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erases keys, chats and your account on the server. Your contacts are told that you no longer exist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra las claves, los chats y tu cuenta en el servidor. Tus contactos sabrán que ya no existes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les clés, les discussions et ton compte sur le serveur. Tes contacts apprennent que tu n’existes plus."
          }
        },
        "it": {
