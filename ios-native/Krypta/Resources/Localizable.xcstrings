    "Sobald dein Kontakt eine Nachricht empfangen hat, wird sie vom Server gelöscht, automatisch, bei jeder Nachricht. Übrig bleibt sie nur auf euren beiden iPhones.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As soon as your contact has received a message, it is deleted from the server, automatically, for every message. It only remains on your two iPhones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cuanto tu contacto recibe un mensaje, se borra del servidor, automáticamente, con cada mensaje. Solo queda en vuestros dos iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que ton contact a reçu un message, il est supprimé du serveur, automatiquement, pour chaque message. Il ne reste que sur vos deux iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appena il tuo contatto ha ricevuto un messaggio, viene eliminato dal server, automaticamente, per ogni messaggio. Resta solo sui vostri due iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra je contact een bericht heeft ontvangen, wordt het van de server verwijderd, automatisch, bij elk bericht. Het blijft alleen op jullie twee iPhones staan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que o teu contacto recebe uma mensagem, ela é apagada do servidor, automaticamente, em cada mensagem. Fica apenas nos vossos dois iPhones."
          }
        }
      }
    },
