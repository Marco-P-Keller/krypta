    "Du kannst sie nur einmal ansehen. Sobald du sie schließt, ist sie für immer weg.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can view it only once. As soon as you close it, it’s gone for good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo puedes verlo una vez. En cuanto lo cierres, desaparecerá para siempre."
