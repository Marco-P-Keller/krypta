    "Sucht 200 Adressen tief. Nur nötig, wenn nach dem Wiederherstellen Guthaben fehlt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches 200 addresses deep. Only needed if a balance is missing after restoring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en 200 direcciones. Solo hace falta si tras restaurar falta saldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche sur 200 adresses. Nécessaire seulement s'il manque du solde après une restauration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca in 200 indirizzi. Serve solo se dopo il ripristino manca del saldo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoekt 200 adressen diep. Alleen nodig als er na het herstellen saldo ontbreekt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca em 200 endereços. Só é necessário se faltar saldo após restaurar."
          }
        }
      }
    },
