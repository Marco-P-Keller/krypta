    "Bildschirmfotos und Aufnahmen zeigen statt deiner Chats eine leere Fläche. Dein Kontakt erfährt trotzdem davon.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots and recordings show an empty area instead of your chats. Your contact is still told about them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas y grabaciones muestran un área vacía en lugar de tus chats. Tu contacto se entera igualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures et enregistrements affichent une zone vide à la place de tes discussions. Ton contact en est tout de même informé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot e registrazioni mostrano un’area vuota al posto delle tue chat. Il tuo contatto viene comunque avvisato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermafbeeldingen en opnames tonen een lege vlak in plaats van je chats. Je contact hoort er toch van."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturas e gravações mostram uma área vazia no lugar das suas conversas. Seu contato fica sabendo mesmo assim."
          }
        }
      }
    },
