    "Du bekommst keine Nachrichten mehr von diesem Kontakt.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won’t receive messages from this contact anymore."
