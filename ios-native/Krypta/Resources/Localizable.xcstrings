    "Wer dir schreibt, steht verschlüsselt in der Nachricht. Der Server sieht nur, dass etwas für dich ankommt.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who is writing to you is stored encrypted inside the message. The server only sees that something is arriving for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quién te escribe va cifrado dentro del mensaje. El servidor solo ve que llega algo para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identité de qui t’écrit est chiffrée dans le message. Le serveur voit seulement que quelque chose arrive pour toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi ti scrive è cifrato nel messaggio. Il server vede solo che arriva qualcosa per te."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie je schrijft, staat versleuteld in het bericht. De server ziet alleen dat er iets voor je binnenkomt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem escreve para você vai criptografado dentro da mensagem. O servidor só vê que algo está chegando para você."
          }
        }
      }
    },
    "Wer sie hat, hat dein Bitcoin. Schreib sie auf Papier und bewahre es sicher auf. Kein Foto, keine Notiz-App, nicht in die Cloud.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever has them has your bitcoin. Write them on paper and keep it somewhere safe. No photo, no notes app, not in the cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien las tenga tiene tu bitcoin. Escríbelas en papel y guárdalo en un lugar seguro. Nada de fotos, ni app de notas, ni la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui les a possède tes bitcoins. Écris-les sur papier et garde-le en lieu sûr. Pas de photo, pas d'app de notes, pas dans le cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi le ha possiede i tuoi bitcoin. Scrivile su carta e conservala al sicuro. Niente foto, niente app di note, niente cloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie ze heeft, heeft je bitcoin. Schrijf ze op papier en bewaar dat veilig. Geen foto, geen notitie-app, niet in de cloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem as tiver tem o seu bitcoin. Escreva-as em papel e guarde em lugar seguro. Nada de foto, app de notas ou nuvem."
          }
        }
      }
    },
