    "Niemand bekommt eine Adresse von dir, und niemand kann dich im Chat bezahlen. Empfangen über den QR-Code geht weiter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody gets an address from you, and nobody can pay you in chat. Receiving via QR code still works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie recibe una dirección tuya y nadie puede pagarte en el chat. Recibir con el código QR sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne reçoit d'adresse de ta part et personne ne peut te payer dans le chat. La réception par code QR fonctionne toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno riceve un tuo indirizzo e nessuno può pagarti in chat. Ricevere con il codice QR funziona ancora."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand krijgt een adres van je en niemand kan je in de chat betalen. Ontvangen via de QR-code blijft werken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém recebe um endereço seu e ninguém pode pagar você no chat. Receber pelo código QR continua funcionando."
          }
        }
      }
    },
