    "Krypta stellt Nachrichten über iCloud zu. Melde dich in den Einstellungen mit deinem Apple-Account an, schalte iCloud für Krypta ein und versuche es noch einmal.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta delivers messages through iCloud. Sign in with your Apple Account in Settings, turn on iCloud for Krypta and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta entrega los mensajes a través de iCloud. Inicia sesión con tu cuenta de Apple en Ajustes, activa iCloud para Krypta e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta distribue les messages via iCloud. Connecte-toi avec ton compte Apple dans Réglages, active iCloud pour Krypta et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta consegna i messaggi tramite iCloud. Accedi con il tuo Account Apple in Impostazioni, attiva iCloud per Krypta e riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta bezorgt berichten via iCloud. Log in Instellingen in met je Apple-account, zet iCloud aan voor Krypta en probeer het opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Krypta entrega as mensagens pelo iCloud. Inicie sessão com sua Conta Apple nos Ajustes, ative o iCloud para o Krypta e tente novamente."
          }
        }
      }
    },
    "Krypta verwendet diese Bibliotheken. Ihre Lizenztexte stehen in den verlinkten Quellen.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta uses these libraries. Their license texts are in the linked sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta usa estas bibliotecas. Sus textos de licencia están en las fuentes enlazadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta utilise ces bibliothèques. Leurs textes de licence se trouvent dans les sources liées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta usa queste librerie. I testi delle licenze si trovano nelle fonti collegate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta gebruikt deze bibliotheken. De licentieteksten staan in de gelinkte bronnen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Krypta usa estas bibliotecas. Os textos das licenças estão nas fontes indicadas."
          }
        }
      }
    },
    "Krypta öffnet sich als Rechner. Geheimcode + = zeigt deine Chats, Löschcode + = löscht alles.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta opens as a calculator. Secret code + = shows your chats, erase code + = erases everything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta se abre como calculadora. Código secreto + = muestra tus chats; código de borrado + = lo borra todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta s’ouvre comme une calculatrice. Code secret + = affiche tes discussions, code d’effacement + = efface tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta si apre come calcolatrice. Codice segreto + = mostra le chat, codice di cancellazione + = cancella tutto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta opent als rekenmachine. Geheime code + = toont je chats, wiscode + = wist alles."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Krypta abre como calculadora. Código secreto + = mostra suas conversas; código de apagamento + = apaga tudo."
          }
        }
      }
    },
    "Krypta öffnet sich dann als gewöhnlicher Rechner. Erst dein Geheimcode, gefolgt von =, zeigt deine Chats. Ein zweiter Code löscht im Notfall alles.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta then opens as an ordinary calculator. Only your secret code followed by = shows your chats. A second code erases everything in an emergency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta se abrirá como una calculadora normal. Solo tu código secreto seguido de = muestra tus chats. Un segundo código lo borra todo en caso de emergencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta s’ouvre alors comme une calculatrice ordinaire. Seul ton code secret suivi de = affiche tes discussions. Un second code efface tout en cas d’urgence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta si aprirà come una normale calcolatrice. Solo il tuo codice segreto seguito da = mostra le chat. Un secondo codice cancella tutto in caso di emergenza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypta opent dan als gewone rekenmachine. Pas je geheime code gevolgd door = toont je chats. Een tweede code wist in noodgevallen alles."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Krypta passa a abrir como uma calculadora comum. Só o seu código secreto seguido de = mostra suas conversas. Um segundo código apaga tudo numa emergência."
          }
        }
      }
    },
    "Lass deinen Kontakt diesen Code mit Krypta scannen. Er gilt zehn Minuten und nur einmal.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have your contact scan this code with Krypta. It’s valid for ten minutes and only once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a tu contacto que escanee este código con Krypta. Vale diez minutos y una sola vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande à ton contact de scanner ce code avec Krypta. Il est valable dix minutes et une seule fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai scansionare questo codice al tuo contatto con Krypta. Vale dieci minuti e una sola volta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat je contact deze code met Krypta scannen. Hij is tien minuten en maar één keer geldig."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça ao seu contato para escanear este código com o Krypta. Ele vale por dez minutos e uma única vez."
          }
        }
      }
    },
