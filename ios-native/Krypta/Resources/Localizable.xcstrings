    "Du hast festgelegt, dass Nachrichten nach dem Lesen gelöscht werden.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You set messages to disappear after reading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuraste que los mensajes se borren tras leerlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as choisi de supprimer les messages après lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai impostato l’eliminazione dei messaggi dopo la lettura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt ingesteld dat berichten na het lezen verdwijnen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você definiu que as mensagens sejam apagadas após a leitura."
          }
        }
      }
    },
    "Du kannst sie nur einmal ansehen. Sobald du sie schließt, ist sie für immer weg.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can view it only once. As soon as you close it, it’s gone for good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo puedes verlo una vez. En cuanto lo cierres, desaparecerá para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne peux le voir qu’une seule fois. Dès que tu le fermes, il disparaît pour toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi vederlo una sola volta. Appena lo chiudi, sparisce per sempre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt het maar één keer bekijken. Zodra je het sluit, is het voorgoed weg."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você só pode vê-la uma vez. Assim que a fechar, ela some para sempre."
          }
        }
      }
    },
    "Du verlässt die Gruppe, und der Verlauf verschwindet von diesem iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You leave the group, and the history disappears from this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sales del grupo y el historial desaparece de este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu quittes le groupe et l’historique disparaît de cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci dal gruppo e la cronologia sparisce da questo iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je verlaat de groep en de geschiedenis verdwijnt van deze iPhone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você sai do grupo e o histórico desaparece deste iPhone."
          }
        }
      }
    },
    "Du verwaltest diese Gruppe: nur du kannst Mitglieder hinzufügen oder entfernen, sie umbenennen und die Löschfrist ändern.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You manage this group: only you can add or remove members, rename it and change disappearing messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú administras este grupo: solo tú puedes añadir o eliminar miembros, cambiarle el nombre y cambiar los mensajes temporales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu gères ce groupe : toi seul peux ajouter ou retirer des membres, le renommer et modifier les messages éphémères."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci tu questo gruppo: solo tu puoi aggiungere o rimuovere membri, rinominarlo e cambiare i messaggi a tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij beheert deze groep: alleen jij kunt leden toevoegen of verwijderen, de groep hernoemen en verdwijnende berichten wijzigen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você administra este grupo: só você pode adicionar ou remover membros, renomeá-lo e alterar as mensagens temporárias."
          }
        }
      }
    },
    "Du zahlst %@ Gebühr für %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're paying a fee of %1$@ for %2$@."
