          }
        }
      }
    },
    "Dafür reicht das freie Guthaben nicht. Bestätigte Münzen kämen dazu, aber es gibt keine.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your available balance isn’t enough. Confirmed coins would be added, but there are none."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo disponible no alcanza. Se añadirían monedas confirmadas, pero no hay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde disponible ne suffit pas. Des pièces confirmées seraient ajoutées, mais il n’y en a pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo disponibile non basta. Si aggiungerebbero monete confermate, ma non ce ne sono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het vrije saldo is niet genoeg. Bevestigde munten zouden erbij komen, maar die zijn er niet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo disponível não é suficiente. Moedas confirmadas seriam adicionadas, mas não há nenhuma."
          }
        }
      }
    },
    "Das Foto wird neu gespeichert, ohne Ort, Kamera und Aufnahmezeit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is saved again, without location, camera or capture time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto se vuelve a guardar sin ubicación, cámara ni hora de captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo est réenregistrée sans lieu, appareil ni heure de prise de vue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto viene salvata di nuovo, senza luogo, fotocamera e ora dello scatto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto wordt opnieuw opgeslagen, zonder locatie, camera en opnametijd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto é salva de novo, sem local, câmera e horário de captura."
          }
        }
      }
    },
    "Das Gerät deines Kontakts löscht sie beim Empfang, dein iPhone noch einmal, sobald die Zustellung bestätigt ist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contact's device deletes it on receipt, and your iPhone does so again once delivery is confirmed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo de tu contacto lo borra al recibirlo y tu iPhone lo vuelve a borrar en cuanto se confirma la entrega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil de ton contact le supprime à la réception, puis ton iPhone une seconde fois dès que la remise est confirmée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo del tuo contatto lo elimina alla ricezione e il tuo iPhone lo elimina di nuovo appena la consegna è confermata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het toestel van je contact verwijdert het bij ontvangst, en je iPhone nog een keer zodra de bezorging bevestigd is."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
