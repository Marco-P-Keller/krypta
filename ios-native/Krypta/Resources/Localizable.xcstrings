    "Mitteilungen aus diesem Chat kommen still: ohne Ton und ohne Zahl am App-Symbol.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications from this chat arrive silently: no sound and no badge on the app icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de este chat llegan en silencio: sin sonido ni número en el icono de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de cette discussion arrivent en silence : sans son ni pastille sur l’icône de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche di questa chat arrivano in silenzio: senza suono e senza numero sull’icona dell’app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen uit deze chat komen stil binnen: zonder geluid en zonder getal op het app-symbool."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações desta conversa chegam em silêncio: sem som e sem número no ícone do app."
          }
        }
      }
    },
