    },
    "Du erfährst, von wem eine Nachricht kommt, zum Beispiel „Neue Nachricht von Mami“. Was drinsteht, sieht nur, wer Krypta öffnet.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll see who a message is from, for example “New message from Mom”. What it says is only visible to whoever opens Krypta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabrás de quién viene un mensaje, por ejemplo «Nuevo mensaje de Mamá». Lo que dice solo lo ve quien abre Krypta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sauras de qui vient un message, par exemple « Nouveau message de Maman ». Son contenu n’est visible qu’en ouvrant Krypta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Saprai da chi arriva un messaggio, per esempio «Nuovo messaggio da Mamma». Il contenuto lo vede solo chi apre Krypta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ziet van wie een bericht komt, bijvoorbeeld ‘Nieuw bericht van Mama’. Wat erin staat, ziet alleen wie Krypta opent."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai saber de quem é a mensagem, por exemplo “Nova mensagem de Mãe”. O conteúdo só aparece para quem abrir o Krypta."
          }
        }
      }
    },
    "Du hast die Löschfrist auf %@ gesetzt.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You set messages to disappear after %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuraste que los mensajes desaparezcan tras %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as réglé la suppression des messages sur %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai impostato l’eliminazione dei messaggi dopo %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt ingesteld dat berichten na %@ verdwijnen."
          }
        },
