    "Ersetzt die Wallet auf diesem iPhone. Wörter einer anderen Wallet (BIP39, BIP84, native Segwit) funktionieren auch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaces the wallet on this iPhone. Words from another wallet (BIP39, BIP84, native SegWit) work too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye el monedero de este iPhone. También sirven las palabras de otro monedero (BIP39, BIP84, SegWit nativo)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace le portefeuille sur cet iPhone. Les mots d'un autre portefeuille (BIP39, BIP84, SegWit natif) fonctionnent aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisce il wallet su questo iPhone. Funzionano anche le parole di un altro wallet (BIP39, BIP84, SegWit nativo)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervangt de wallet op deze iPhone. Woorden van een andere wallet (BIP39, BIP84, native SegWit) werken ook."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui a carteira neste iPhone. Palavras de outra carteira (BIP39, BIP84, SegWit nativo) também funcionam."
