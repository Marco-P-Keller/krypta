          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia sparisce da questo iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geschiedenis verdwijnt van deze iPhone."
          }
        },
        "pt": {
