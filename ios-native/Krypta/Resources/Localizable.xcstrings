    "%@ hat festgelegt, dass Nachrichten nach dem Lesen gelöscht werden.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ set messages to disappear after reading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ configuró que los mensajes se borren tras leerlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a choisi de supprimer les messages après lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha impostato l’eliminazione dei messaggi dopo la lettura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft ingesteld dat berichten na het lezen verdwijnen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ definiu que as mensagens sejam apagadas após a leitura."
          }
        }
      }
    },
    "%@ kann im Chat keine Bitcoin empfangen (ältere Krypta-Version oder Zahlungen im Chat ausgeschaltet).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can't receive bitcoin in chat (older Krypta version or chat payments turned off)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no puede recibir bitcoin en el chat (versión antigua de Krypta o pagos en el chat desactivados)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas recevoir de bitcoins dans le chat (ancienne version de Krypta ou paiements dans le chat désactivés)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non può ricevere bitcoin in chat (versione di Krypta meno recente o pagamenti in chat disattivati)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan in de chat geen bitcoin ontvangen (oudere Krypta-versie of betalingen in de chat uitgeschakeld)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não pode receber bitcoin no chat (versão antiga do Krypta ou pagamentos no chat desativados)."
          }
        }
      }
    },
