    "%@ hat die Löschfrist auf %@ gesetzt.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ set messages to disappear after %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ configuró que los mensajes desaparezcan tras %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a réglé la suppression des messages sur %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha impostato l’eliminazione dei messaggi dopo %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft ingesteld dat berichten na %2$@ verdwijnen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ definiu que as mensagens desapareçam após %2$@."
          }
        }
      }
    },
    "%@ hat die Löschfrist ausgeschaltet.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ turned off disappearing messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ desactivó los mensajes temporales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a désactivé les messages éphémères."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha disattivato i messaggi a tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft verdwijnende berichten uitgezet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ desativou as mensagens temporárias."
          }
        }
      }
    },
    "%@ hat dir noch keine Bitcoin-Adresse geschickt. Sie kommt verschlüsselt mit der nächsten Nachricht von %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hasn't sent you a bitcoin address yet. It arrives encrypted with the next message from %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aún no te ha enviado una dirección de bitcoin. Llegará cifrada con el próximo mensaje de %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne t'a pas encore envoyé d'adresse bitcoin. Elle arrivera chiffrée avec le prochain message de %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non ti ha ancora inviato un indirizzo bitcoin. Arriverà cifrato con il prossimo messaggio di %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft je nog geen bitcoinadres gestuurd. Het komt versleuteld mee met het volgende bericht van %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ainda não enviou um endereço de bitcoin. Ele chega criptografado com a próxima mensagem de %2$@."
          }
        }
      }
    },
