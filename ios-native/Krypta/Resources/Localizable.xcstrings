    "Vergleicht diese Zahl auf beiden Geräten, am besten nebeneinander oder in einem Anruf. Stimmt sie überein, liest niemand mit.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare this number on both devices, ideally side by side or during a call. If it matches, nobody is listening in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparad este número en ambos dispositivos, mejor juntos o durante una llamada. Si coincide, nadie está leyendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez ce numéro sur les deux appareils, idéalement côte à côte ou pendant un appel. S’il est identique, personne ne lit par-dessus votre épaule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confrontate questo numero su entrambi i dispositivi, meglio vicini o durante una chiamata. Se coincide, nessuno sta leggendo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijk dit nummer op beide apparaten, het liefst naast elkaar of tijdens een gesprek. Komt het overeen, dan leest niemand mee."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparem este número nos dois aparelhos, de preferência lado a lado ou numa ligação. Se coincidir, ninguém está lendo junto."
          }
        }
      }
    },
