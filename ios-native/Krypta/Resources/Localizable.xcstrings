    "Im Notfall: dieser Code + = löscht sofort alles, ohne Rückfrage.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In an emergency: this code + = erases everything instantly, without asking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En caso de emergencia: este código + = lo borra todo al instante, sin preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas d’urgence : ce code + = efface tout immédiatement, sans confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In caso di emergenza: questo codice + = cancella subito tutto, senza chiedere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In noodgevallen: deze code + = wist meteen alles, zonder te vragen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em emergência: este código + = apaga tudo na hora, sem perguntar."
          }
        }
      }
    },
