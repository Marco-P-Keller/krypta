    "%@ hat festgelegt, dass Nachrichten nach dem Lesen gelöscht werden.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ set messages to disappear after reading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ configuró que los mensajes se borren tras leerlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a choisi de supprimer les messages après lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha impostato l’eliminazione dei messaggi dopo la lettura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft ingesteld dat berichten na het lezen verdwijnen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ definiu que as mensagens sejam apagadas após a leitura."
          }
        }
      }
    },
