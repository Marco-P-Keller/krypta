    "Stimmt die Nummer auf beiden Geräten überein, sitzt niemand dazwischen. Ändert sie sich, sperrt Krypta den Chat, bis ihr sie neu vergleicht.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the number matches on both devices, nobody is in between. If it changes, Krypta locks the chat until you compare it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el número coincide en ambos dispositivos, no hay nadie en medio. Si cambia, Krypta bloquea el chat hasta que lo volváis a comparar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le numéro est identique sur les deux appareils, personne ne s’est interposé. S’il change, Krypta verrouille la discussion jusqu’à une nouvelle comparaison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il numero coincide su entrambi i dispositivi, nessuno si è intromesso. Se cambia, Krypta blocca la chat finché non lo confrontate di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komt het nummer op beide apparaten overeen, dan zit er niemand tussen. Verandert het, dan vergrendelt Krypta de chat totdat jullie het opnieuw vergelijken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o número coincidir nos dois aparelhos, ninguém está no meio. Se mudar, o Krypta bloqueia a conversa até vocês compararem de novo."
          }
        }
      }
    },
