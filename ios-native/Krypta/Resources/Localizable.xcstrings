    "Zustellungen werden immer gemeldet, weil an ihnen der Start der Löschfristen hängt. Lesebestätigungen nur, wenn du sie einschaltest.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deliveries are always reported, because disappearing timers start on delivery. Read receipts only if you turn them on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las entregas siempre se notifican, porque de ellas depende el inicio de los plazos de borrado. Las confirmaciones de lectura, solo si las activas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les distributions sont toujours signalées, car le délai de suppression commence à ce moment-là. Les accusés de lecture, seulement si tu les actives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le consegne vengono sempre segnalate, perché da lì parte il timer di eliminazione. Le conferme di lettura solo se le attivi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afleveringen worden altijd gemeld, omdat de verdwijntermijn dan begint. Leesbevestigingen alleen als je ze aanzet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As entregas são sempre informadas, porque é nelas que começa o prazo de apagamento. As confirmações de leitura, só se você ativá-las."
          }
        }
      }
    },
