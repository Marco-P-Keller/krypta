    "Dein Guthaben hat sich gerade geändert. Prüfe die Zahlung bitte noch einmal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your balance just changed. Please check the payment again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu saldo acaba de cambiar. Revisa el pago otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton solde vient de changer. Vérifie à nouveau le paiement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo saldo è appena cambiato. Controlla di nuovo il pagamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je saldo is net veranderd. Controleer de betaling nog eens."
