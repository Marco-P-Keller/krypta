            "state": "translated",
            "value": "Los archivos se envían tal cual. Lo que contiene el archivo se queda dentro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers partent tels quels. Ce qu’ils contiennent y reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file vengono inviati così come sono. Ciò che contengono resta dentro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden gaan zoals ze zijn. Wat erin staat, blijft erin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos vão como estão. O que está dentro do arquivo fica dentro."
          }
