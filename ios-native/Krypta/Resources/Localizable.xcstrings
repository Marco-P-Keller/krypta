    "Alle Mitglieder sehen den Namen der Gruppe. Wie du deine Kontakte genannt hast, sehen sie nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All members see the group name. They don’t see what you named your contacts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los miembros ven el nombre del grupo. No ven cómo has llamado a tus contactos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les membres voient le nom du groupe. Ils ne voient pas comment tu as nommé tes contacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i membri vedono il nome del gruppo. Non vedono come hai chiamato i tuoi contatti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle leden zien de groepsnaam. Hoe jij je contacten hebt genoemd, zien ze niet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os membros veem o nome do grupo. Eles não veem como você nomeou seus contatos."
          }
        }
      }
    },
    "Alle Mitglieder sehen den neuen Namen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All members will see the new name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los miembros verán el nuevo nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les membres verront le nouveau nom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i membri vedranno il nuovo nome."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle leden zien de nieuwe naam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os membros verão o novo nome."
          }
        }
      }
    },
    "Alle Nachrichten verschwinden hier. Deine eigenen werden auch bei %@ entfernt.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All messages will disappear here. Yours will also be removed for %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los mensajes desaparecerán aquí. Los tuyos también se eliminarán para %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les messages disparaîtront ici. Les tiens seront aussi supprimés chez %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i messaggi spariranno qui. I tuoi verranno rimossi anche per %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle berichten verdwijnen hier. Die van jou worden ook bij %@ verwijderd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as mensagens vão sumir aqui. As suas também serão removidas para %@."
          }
        }
      }
    },
    "Alle, die du einladen kannst, sind schon dabei.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone you can invite is already in the group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los que puedes invitar ya están en el grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous ceux que tu peux inviter sont déjà dans le groupe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti quelli che puoi invitare sono già nel gruppo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen die je kunt uitnodigen, zit al in de groep."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
