    "Anfrage gesendet. Ihr könnt schreiben, sobald %@ annimmt.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request sent. You can chat as soon as %@ accepts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitud enviada. Podréis escribiros en cuanto %@ la acepte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande envoyée. Vous pourrez discuter dès que %@ l’aura acceptée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiesta inviata. Potrete scrivervi appena %@ accetta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzoek verstuurd. Jullie kunnen chatten zodra %@ het accepteert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedido enviado. Vocês poderão conversar assim que %@ aceitar."
          }
        }
      }
    },
