          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Detalhes"
          }
        }
      }
    },
    "Die Adresse hat dein Kontakt verschlüsselt im Chat geschickt, nur für dich. Jede Zahlung geht an eine neue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contact sent this address encrypted in the chat, just for you. Every payment goes to a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contacto envió esta dirección cifrada en el chat, solo para ti. Cada pago va a una nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton contact a envoyé cette adresse chiffrée dans le chat, rien que pour toi. Chaque paiement va vers une nouvelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo contatto ha inviato questo indirizzo cifrato in chat, solo per te. Ogni pagamento va a uno nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je contact heeft dit adres versleuteld in de chat gestuurd, alleen voor jou. Elke betaling gaat naar een nieuw adres."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu contato enviou este endereço criptografado no chat, só para você. Cada pagamento vai para um novo."
          }
        }
      }
    },
    "Die Codes stimmen nicht überein. Versuche es noch einmal.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The codes don’t match. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los códigos no coinciden. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes ne correspondent pas. Réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I codici non coincidono. Riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De codes komen niet overeen. Probeer het opnieuw."
          }
        },
        "pt": {
