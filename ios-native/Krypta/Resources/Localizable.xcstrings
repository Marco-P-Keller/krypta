        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne peux le voir qu’une seule fois. Dès que tu le fermes, il disparaît pour toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi vederlo una sola volta. Appena lo chiudi, sparisce per sempre."
