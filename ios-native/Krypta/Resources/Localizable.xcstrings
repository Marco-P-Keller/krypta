    "Chats und Schlüssel liegen verschlüsselt auf dem iPhone, der Schlüssel dazu im Schlüsselbund. Nichts davon landet in Backups.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats and keys are stored encrypted on the iPhone, with the key in the Keychain. None of it ends up in backups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los chats y las claves se guardan cifrados en el iPhone, y la clave en el llavero. Nada de ello va a las copias de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les discussions et les clés sont chiffrées sur l’iPhone, la clé est dans le trousseau. Rien de tout cela ne finit dans les sauvegardes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat e chiavi sono cifrate sull’iPhone, la chiave è nel portachiavi. Niente di tutto ciò finisce nei backup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats en sleutels staan versleuteld op de iPhone, de sleutel daarvoor in de sleutelhanger. Niets daarvan komt in back-ups terecht."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversas e chaves ficam criptografadas no iPhone, com a chave nas Chaves. Nada disso vai para os backups."
          }
        }
      }
    },
    "Code bestätigen": {
      "extractionState": "extracted_with_value",
