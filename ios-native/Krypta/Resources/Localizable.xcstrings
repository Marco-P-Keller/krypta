    "Die Wörter konnten nicht übernommen werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The words couldn't be applied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron aplicar las palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots n'ont pas pu être appliqués."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile applicare le parole."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De woorden konden niet worden overgenomen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível aplicar as palavras."
          }
        }
      }
    },
    "Die Zahlung läuft über die Bitcoin-Blockchain. Die Nachricht im Chat sagt deinem Kontakt nur, dass und wohin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payment goes over the bitcoin blockchain. The chat message only tells your contact that you paid and where to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago va por la blockchain de bitcoin. El mensaje del chat solo le dice a tu contacto que pagaste y adónde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement passe par la blockchain bitcoin. Le message dans le chat indique seulement à ton contact que tu as payé et vers quelle adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento passa dalla blockchain bitcoin. Il messaggio in chat dice al tuo contatto solo che hai pagato e dove."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De betaling loopt via de bitcoin-blockchain. Het chatbericht vertelt je contact alleen dat je hebt betaald en waarheen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento passa pela blockchain do bitcoin. A mensagem no chat só diz ao seu contato que você pagou e para onde."
          }
        }
      }
    },
    "Die jetzige Wallet wird durch die aus diesen Wörtern ersetzt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current wallet will be replaced by the one from these words."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El monedero actual se sustituirá por el de estas palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portefeuille actuel sera remplacé par celui de ces mots."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il wallet attuale sarà sostituito da quello di queste parole."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De huidige wallet wordt vervangen door die van deze woorden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira atual será substituída pela destas palavras."
          }
        }
      }
    },
    "Die jetzige Wallet wird ersetzt. Ohne ihre eigenen Wörter ist ihr Guthaben danach verloren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current wallet will be replaced. Without its own words, its balance is lost afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El monedero actual se sustituirá. Sin sus propias palabras, su saldo se perderá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portefeuille actuel sera remplacé. Sans ses propres mots, son solde sera perdu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il wallet attuale sarà sostituito. Senza le sue parole, il suo saldo andrà perso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De huidige wallet wordt vervangen. Zonder zijn eigen woorden is het saldo daarna verloren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira atual será substituída. Sem as palavras dela, o saldo se perde."
          }
        }
      }
    },
    "Diese Adresse gehört zu einem anderen Bitcoin-Netz.": {
