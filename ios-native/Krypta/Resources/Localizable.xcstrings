    "Bitcoin-Zahlungen lassen sich nicht zurückholen. Prüfe Empfänger und Betrag. Zum Senden fragt Krypta nach %@ oder deinem Gerätecode.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin payments can't be reversed. Check recipient and amount. To send, Krypta asks for %@ or your device passcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pagos en bitcoin no se pueden revertir. Revisa destinatario e importe. Para enviar, Krypta pide %@ o el código del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paiements en bitcoin sont irréversibles. Vérifie le destinataire et le montant. Pour envoyer, Krypta demande %@ ou le code de l'appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pagamenti in bitcoin non si possono annullare. Controlla destinatario e importo. Per inviare, Krypta chiede %@ o il codice del dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoinbetalingen kun je niet terugdraaien. Controleer ontvanger en bedrag. Om te versturen vraagt Krypta om %@ of je toegangscode."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamentos em bitcoin não podem ser revertidos. Confira destinatário e valor. Para enviar, o Krypta pede %@ ou o código do aparelho."
          }
        }
      }
    },
