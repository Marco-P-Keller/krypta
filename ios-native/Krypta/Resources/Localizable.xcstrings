            "value": "La tua reazione %@. Tocca per rimuoverla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw reactie %@. Tik om te verwijderen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua reação %@. Toque para remover."
          }
        }
      }
    },
    "Deine Schlüssel entstehen gleich auf diesem iPhone und verlassen es nie.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your keys are about to be created on this iPhone, and they never leave it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus claves se crearán ahora en este iPhone y nunca saldrán de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes clés vont être créées sur cet iPhone et ne le quitteront jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue chiavi stanno per essere create su questo iPhone e non lo lasceranno mai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sleutels worden zo op deze iPhone gemaakt en verlaten hem nooit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas chaves serão criadas agora neste iPhone e nunca sairão dele."
          }
        }
      }
    },
    "Deine Schlüssel konnten nicht veröffentlicht werden. Andere können dich gerade nicht erreichen.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your keys couldn’t be published. Others can’t reach you right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron publicar tus claves. Ahora mismo nadie puede contactarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes clés n’ont pas pu être publiées. Personne ne peut te joindre pour l’instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile pubblicare le tue chiavi. Al momento nessuno può raggiungerti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sleutels konden niet worden gepubliceerd. Anderen kunnen je nu niet bereiken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível publicar suas chaves. No momento, ninguém consegue falar com você."
          }
        }
      }
    },
    "Der Anhang konnte nicht vorbereitet werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The attachment couldn’t be prepared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido preparar el adjunto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pièce jointe n’a pas pu être préparée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile preparare l’allegato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bijlage kon niet worden voorbereid."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível preparar o anexo."
          }
        }
      }
    },
    "Der Betrag ist zu klein. Mindestens %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The amount is too small. At least %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El importe es demasiado pequeño. Mínimo %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant est trop faible. Au moins %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importo è troppo piccolo. Almeno %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bedrag is te klein. Minstens %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor é muito pequeno. No mínimo %@."
          }
        }
      }
    },
    "Der Bitcoin-Server antwortet gerade nicht richtig. Versuch es gleich noch einmal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bitcoin server isn't responding properly right now. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de bitcoin no responde bien ahora mismo. Inténtalo de nuevo enseguida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur bitcoin ne répond pas correctement en ce moment. Réessaie dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server bitcoin al momento non risponde correttamente. Riprova tra poco."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bitcoinserver reageert nu niet goed. Probeer het zo nog eens."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de bitcoin não está respondendo direito agora. Tente de novo em instantes."
          }
        }
      }
    },
    "Der Chat verschwindet von diesem iPhone. Bei %@ werden deine Nachrichten entfernt.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chat will disappear from this iPhone. Your messages will be removed for %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chat desaparecerá de este iPhone. Tus mensajes se eliminarán para %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La discussion disparaîtra de cet iPhone. Tes messages seront supprimés chez %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chat sparirà da questo iPhone. I tuoi messaggi verranno rimossi per %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De chat verdwijnt van deze iPhone. Je berichten worden bij %@ verwijderd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversa vai sumir deste iPhone. Suas mensagens serão removidas para %@."
          }
        }
      }
    },
    "Der Code konnte nicht gespeichert werden.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code couldn’t be saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code n’a pas pu être enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il codice."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code kon niet worden bewaard."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o código."
          }
        }
      }
    },
    "Der Empfänger bekommt genau denselben Betrag. Die neue Transaktion ersetzt die alte; beide geben dieselben Münzen aus, es kann also nur eine gelten. Im Chat bekommt dein Kontakt die neue Kennung verschlüsselt nachgereicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recipient receives exactly the same amount. The new transaction replaces the old one; both spend the same coins, so only one can be valid. In the chat, your contact receives the new ID encrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El destinatario recibe exactamente el mismo importe. La nueva transacción sustituye a la anterior; ambas gastan las mismas monedas, así que solo una puede valer. En el chat, tu contacto recibe el nuevo identificador cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le destinataire reçoit exactement le même montant. La nouvelle transaction remplace l’ancienne ; les deux dépensent les mêmes pièces, une seule peut donc être valable. Dans la discussion, ton contact reçoit le nouvel identifiant chiffré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il destinatario riceve esattamente lo stesso importo. La nuova transazione sostituisce la vecchia; entrambe spendono le stesse monete, quindi solo una può valere. Nella chat il tuo contatto riceve il nuovo identificativo cifrato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ontvanger krijgt precies hetzelfde bedrag. De nieuwe transactie vervangt de oude; beide geven dezelfde munten uit, dus er kan er maar één gelden. In de chat krijgt je contact de nieuwe ID versleuteld nagestuurd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O destinatário recebe exatamente o mesmo valor. A nova transação substitui a antiga; ambas gastam as mesmas moedas, então só uma pode valer. No chat, seu contato recebe o novo identificador criptografado."
          }
        }
      }
    },
    "Der Löschcode muss sich vom Geheimcode unterscheiden.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The erase code must be different from the secret code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de borrado debe ser distinto del código secreto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code d’effacement doit être différent du code secret."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice di cancellazione deve essere diverso dal codice segreto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wiscode moet verschillen van de geheime code."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O código de apagamento precisa ser diferente do código secreto."
          }
        }
      }
    },
    "Der Schlüssel im QR-Code passt nicht zu dem auf dem Server. Möglicher Angriff: Der Kontakt wurde gesperrt.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key in the QR code doesn’t match the one on the server. Possible attack: the contact has been locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave del código QR no coincide con la del servidor. Posible ataque: el contacto se ha bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé du code QR ne correspond pas à celle du serveur. Attaque possible : le contact a été verrouillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave nel codice QR non corrisponde a quella sul server. Possibile attacco: il contatto è stato bloccato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutel in de QR-code komt niet overeen met die op de server. Mogelijke aanval: het contact is vergrendeld."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave do código QR não corresponde à do servidor. Possível ataque: o contato foi bloqueado."
          }
        }
      }
    },
    "Der Schlüssel liegt im Schlüsselbund nur dieses iPhones, nicht in Backups und nicht in iCloud. Selbst Krypta kommt ohne deine Bestätigung nicht an ihn heran.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is in this iPhone's keychain only, not in backups and not in iCloud. Even Krypta can't reach it without your confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave está solo en el llavero de este iPhone, ni en copias de seguridad ni en iCloud. Ni siquiera Krypta llega a ella sin tu confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé se trouve uniquement dans le trousseau de cet iPhone, ni dans les sauvegardes ni dans iCloud. Même Krypta n'y accède pas sans ta confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave è solo nel portachiavi di questo iPhone, non nei backup e non in iCloud. Nemmeno Krypta può usarla senza la tua conferma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutel staat alleen in de sleutelhanger van deze iPhone, niet in back-ups en niet in iCloud. Zelfs Krypta kan er zonder jouw bevestiging niet bij."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave fica só nas chaves deste iPhone, não em backups nem no iCloud. Nem o Krypta chega a ela sem a sua confirmação."
          }
        }
      }
    },
    "Der Server hat die Erhöhung abgelehnt. Die bisherige Zahlung gilt weiter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected the increase. The existing payment still stands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor ha rechazado el aumento. El pago anterior sigue siendo válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé l’augmentation. Le paiement actuel reste valable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha rifiutato l’aumento. Il pagamento precedente resta valido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server heeft de verhoging geweigerd. De bestaande betaling blijft gelden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recusou o aumento. O pagamento anterior continua valendo."
          }
        }
      }
    },
    "Der Server hat die Zahlung abgelehnt. Es wurde nichts gesendet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected the payment. Nothing was sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó el pago. No se envió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé le paiement. Rien n'a été envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha rifiutato il pagamento. Non è stato inviato nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server heeft de betaling geweigerd. Er is niets verstuurd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recusou o pagamento. Nada foi enviado."
          }
        }
      }
    },
    "Der Server vergisst": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Server Forgets"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor olvida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur oublie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server dimentica"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server vergeet"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor esquece"
          }
        }
      }
    },
    "Der Server zeigt dir für diesen Kontakt dieselbe lückenlose, signierte Schlüsselkette wie allen anderen, und sie endet bei dem Schlüssel, den du kennst.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server shows you the same complete, signed key chain for this contact as everyone else, and it ends with the key you know."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor te muestra para este contacto la misma cadena de claves firmada y completa que a todos los demás, y termina en la clave que conoces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur te montre pour ce contact la même chaîne de clés signée et complète qu’à tous les autres, et elle se termine par la clé que tu connais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ti mostra per questo contatto la stessa catena di chiavi firmata e completa che mostra a tutti, e termina con la chiave che conosci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server toont je voor dit contact dezelfde volledige, ondertekende sleutelketen als iedereen, en die eindigt bij de sleutel die jij kent."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor mostra para este contato a mesma cadeia de chaves assinada e completa que mostra a todos, e ela termina na chave que você conhece."
          }
        }
      }
    },
    "Der Verlauf verschwindet von diesem iPhone.": {
      "localizations": {
        "en": {
