    "Was nie abgeholt wird, löscht der Server nach 24 Stunden von selbst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything that is never picked up is deleted by the server on its own after 24 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que nunca se recoge, el servidor lo borra solo a las 24 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui n'est jamais récupéré est supprimé automatiquement par le serveur au bout de 24 heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che non viene mai ritirato, il server lo elimina da solo dopo 24 ore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat nooit wordt opgehaald, verwijdert de server na 24 uur vanzelf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que nunca é recolhido, o servidor apaga sozinho ao fim de 24 horas."
          }
        }
      }
    },
