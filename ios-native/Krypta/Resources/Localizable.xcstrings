    "%@ verwaltet diese Gruppe. Mitglieder, die du nicht kennst, sind nicht verifiziert, bis du ihre Sicherheitsnummer vergleichst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ manages this group. Members you don’t know aren’t verified until you compare their safety number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ administra este grupo. Los miembros que no conoces no están verificados hasta que compares su número de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gère ce groupe. Les membres que tu ne connais pas ne sont pas vérifiés tant que tu n’as pas comparé leur numéro de sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gestisce questo gruppo. I membri che non conosci non sono verificati finché non confronti il loro numero di sicurezza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ beheert deze groep. Leden die je niet kent, zijn niet geverifieerd tot je hun veiligheidsnummer vergelijkt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ administra este grupo. Membros que você não conhece não estão verificados até você comparar o número de segurança deles."
          }
        }
      }
    },
