    "Testnet4 und Signet sind Spielgeld zum Ausprobieren, mit denselben zwölf Wörtern. Beide Seiten eines Chats müssen dasselbe Netz nutzen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Testnet4 and Signet are play money for trying things out, with the same twelve words. Both sides of a chat must use the same network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Testnet4 y Signet son dinero de juego para probar, con las mismas doce palabras. Ambos lados de un chat deben usar la misma red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Testnet4 et Signet sont de l'argent fictif pour essayer, avec les mêmes douze mots. Les deux côtés d'un chat doivent utiliser le même réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testnet4 e Signet sono soldi finti per provare, con le stesse dodici parole. Entrambi i lati di una chat devono usare la stessa rete."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Testnet4 en Signet zijn speelgeld om te proberen, met dezelfde twaalf woorden. Beide kanten van een chat moeten hetzelfde netwerk gebruiken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Testnet4 e Signet são dinheiro de brincadeira para testar, com as mesmas doze palavras. Os dois lados de um chat precisam usar a mesma rede."
          }
        }
      }
    },
    "Testnetz, kein echtes Geld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test network, not real money"
          }
        },
        "es": {
