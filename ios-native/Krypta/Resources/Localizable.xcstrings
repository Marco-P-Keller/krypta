    "Nachrichten liegen nur so lange auf dem Server, bis dein Gerät sie abholt.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages stay on the server only until your device picks them up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes solo están en el servidor hasta que tu dispositivo los recoge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages ne restent sur le serveur que jusqu’à ce que ton appareil les récupère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi restano sul server solo finché il tuo dispositivo non li scarica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten staan alleen op de server totdat je apparaat ze ophaalt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens só ficam no servidor até seu aparelho buscá-las."
          }
        }
      }
    },
    "Nachrichten sind nur auf deinem Gerät und dem deines Kontakts lesbar. Nicht einmal der Server sieht, wer schreibt.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages can be read only on your device and your contact’s. Not even the server sees who is writing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes solo se pueden leer en tu dispositivo y en el de tu contacto. Ni siquiera el servidor ve quién escribe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages ne sont lisibles que sur ton appareil et celui de ton contact. Même le serveur ne voit pas qui écrit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi sono leggibili solo sul tuo dispositivo e su quello del tuo contatto. Nemmeno il server vede chi scrive."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten zijn alleen leesbaar op jouw apparaat en dat van je contact. Zelfs de server ziet niet wie schrijft."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens só podem ser lidas no seu aparelho e no do seu contato. Nem o servidor vê quem está escrevendo."
          }
        }
      }
    },
    "Nachrichten werden auf feste Größen aufgefüllt, damit man an der Länge nichts ablesen kann.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages are padded to fixed sizes so nothing can be inferred from their length."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes se rellenan hasta tamaños fijos para que no se deduzca nada de su longitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages sont complétés à des tailles fixes pour que leur longueur ne révèle rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi vengono riempiti fino a dimensioni fisse, così la lunghezza non rivela nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten worden aangevuld tot vaste groottes, zodat je niets uit de lengte kunt afleiden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens são completadas até tamanhos fixos para que nada possa ser deduzido pelo comprimento."
          }
        }
      }
    },
