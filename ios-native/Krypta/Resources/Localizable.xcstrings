    "Am sichersten: Scannt euch gegenseitig, wenn ihr nebeneinandersteht. Dann ist der Kontakt sofort verifiziert.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safest option: scan each other’s codes while standing side by side. The contact is then verified right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo más seguro: escaneaos mutuamente estando juntos. Así el contacto queda verificado al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus sûr : scannez-vous mutuellement côte à côte. Le contact est alors vérifié aussitôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scelta più sicura: scansionatevi a vicenda stando vicini. Il contatto sarà subito verificato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het veiligst: scan elkaar terwijl je naast elkaar staat. Dan is het contact meteen geverifieerd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mais seguro: escaneiem um ao outro lado a lado. Assim o contato fica verificado na hora."
          }
        }
      }
    },
