    "Hängt die Zahlung, weil die Gebühr zu niedrig war, geht sie mit höherer Gebühr noch einmal hinaus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the payment is stuck because the fee was too low, it goes out again with a higher fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el pago está atascado porque la comisión era demasiado baja, se vuelve a enviar con una comisión más alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le paiement est bloqué parce que les frais étaient trop bas, il repart avec des frais plus élevés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il pagamento è bloccato perché la commissione era troppo bassa, viene reinviato con una commissione più alta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijft de betaling hangen omdat de kosten te laag waren, dan gaat ze met hogere kosten opnieuw de deur uit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o pagamento está travado porque a taxa era baixa demais, ele sai de novo com uma taxa maior."
          }
        }
      }
    },
