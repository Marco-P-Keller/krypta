<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
	</array>
	<!-- Cover identity: the springboard, app switcher, Settings.app and the
	     share sheet all read these. They must match the calculator the app
	     presents before unlock, never the product name. Localized in
	     Runner/en.lproj + Runner/de.lproj InfoPlist.strings. -->
	<key>CFBundleDisplayName</key>
	<string>Calc</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Calc</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID unlocks the app without typing your passcode.</string>
	<key>NSCameraUsageDescription</key>
	<string>The camera is used to scan a QR code for pairing.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Photo access is used to import a pairing QR code you already saved.</string>
	<!-- Only modes the app actually implements may be declared (2.5.4).
	     Message wake-up runs over silent pushes; there is no background fetch
	     handler, so `fetch` is not declared. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Security: Enforce ATS (HTTPS only, TLS 1.2+) + certificate pinning.
	     NSPinnedDomains pins Firebase/Google intermediate CAs (iOS 14+).
	     Equivalent to Android's network_security_config.xml pin-set. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSPinnedDomains</key>
		<dict>
			<key>firebaseio.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSPinnedCAIdentities</key>
				<array>
					<!-- GTS Root R1 (primary Google CA) -->
					<dict>
						<key>SPKI-SHA256-BASE64</key>
						<string>hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</string>
					</dict>
					<!-- GTS Root R4 (backup pin) -->
					<dict>
						<key>SPKI-SHA256-BASE64</key>
						<string>mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</string>
					</dict>
				</array>
			</dict>
			<key>googleapis.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSPinnedCAIdentities</key>
				<array>
					<dict>
						<key>SPKI-SHA256-BASE64</key>
						<string>hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</string>
					</dict>
					<dict>
						<key>SPKI-SHA256-BASE64</key>
						<string>mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</string>
					</dict>
				</array>
			</dict>
		</dict>
	</dict>
	<!-- Encryption export compliance: app uses Signal Protocol (X3DH + Double Ratchet
	     + XChaCha20-Poly1305). This is non-exempt encryption. Handle export compliance
	     questionnaire in App Store Connect during submission. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
</dict>
</plist>
